---
layout: default
title: Events
nav_key: events
---

<div class="flex flex-col w-full -mt-20">
  <!-- Hero Section -->
  <section class="relative w-full h-[614px] min-h-[500px] flex items-end pt-20">
    <div class="absolute inset-0 z-0">
      <div class="w-full h-full bg-cover bg-center"
           role="img"
           aria-label="A sun-dappled creek flowing over dark, wet rocks in a lush green forest, the water reflecting the bright canopy above."
           style="background-image: url('<%= relative_url "/images/photos/forest-creek.jpg" %>')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/50 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop pb-stack-lg">
      <div class="max-w-2xl">
        <p class="font-label-lg text-label-lg text-on-primary/80 uppercase tracking-widest mb-4">Gather at the Bakery</p>
        <h1 class="font-display-lg text-display-lg text-on-primary mb-6">Community Events</h1>
        <p class="font-body-lg text-body-lg text-on-primary/90 max-w-xl">
          Join us for workshops, tastings, and seasonal gatherings that celebrate the art of baking and the joy of coming together.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="w-full bg-surface py-stack-lg">
    <div class="max-w-container-max mx-auto px-margin-mobile lg:px-margin-desktop">
      <div class="flex flex-col lg:flex-row gap-gutter">
        <!-- Main Events List -->
        <div class="w-full lg:w-2/3 flex flex-col gap-stack-md">
          <% site.data.events.each do |event| %>
            <article class="group flex flex-col sm:flex-row gap-6 p-6 bg-surface-container-lowest rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 relative overflow-hidden">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary transform scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>
              <div class="w-full sm:w-1/3 aspect-[4/3] sm:aspect-auto sm:h-40 rounded-lg overflow-hidden shrink-0">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                     src="<%= relative_url "/images/photos/#{event.image}" %>"
                     alt="<%= event.alt %>"
                     loading="lazy" />
              </div>
              <div class="flex flex-col justify-between flex-grow">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="inline-flex items-center px-3 py-1 <%= event.category_classes %> text-primary font-label-sm text-label-sm rounded-full">
                      <%= event.category %>
                    </span>
                    <time class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1" datetime="<%= event.date.strftime("%Y-%m-%d") %>">
                      <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                      <%= event.date_label %>
                    </time>
                  </div>
                  <h2 class="font-headline-md text-headline-md text-on-surface mb-2 group-hover:text-secondary transition-colors"><%= event.title %></h2>
                  <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">
                    <%= event.description %>
                  </p>
                </div>
                <div class="mt-4 flex items-center justify-between">
                  <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">schedule</span>
                    <%= event.time_label %>
                  </span>
                  <a aria-label="<%= event.cta_label %>"
                     class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary hover:text-secondary transition-colors group/link"
                     href="<%= event.cta_href %>">
                    <%= event.cta %>
                    <span class="material-symbols-outlined text-[20px] transform group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
                  </a>
                </div>
              </div>
            </article>
          <% end %>
        </div>

        <!-- Sidebar -->
        <aside class="w-full lg:w-1/3 flex flex-col gap-stack-md">
          <!-- Host an Event Card -->
          <div class="bg-primary-container p-8 rounded-xl shadow-md text-on-primary-container relative overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 bg-primary rounded-full blur-3xl opacity-50 pointer-events-none"></div>
            <h3 class="font-headline-md text-headline-md text-on-primary mb-4 relative z-10">Host Your Event Here</h3>
            <p class="font-body-md text-body-md mb-6 relative z-10 text-on-primary/90">
              Looking for a warm, inviting space for your next gathering? Our bakery is available for private events after hours.
            </p>
            <ul class="flex flex-col gap-3 mb-8 relative z-10">
              <li class="flex items-center gap-2 font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[18px] text-primary-fixed">check_circle</span>
                Capacity for up to 40 guests
              </li>
              <li class="flex items-center gap-2 font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[18px] text-primary-fixed">check_circle</span>
                Custom catering options
              </li>
              <li class="flex items-center gap-2 font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[18px] text-primary-fixed">check_circle</span>
                Artisanal ambiance
              </li>
            </ul>
            <button class="w-full min-h-[48px] bg-primary text-on-primary font-label-lg text-label-lg rounded hover:bg-inverse-surface hover:text-inverse-on-surface transition-colors shadow-sm relative z-10">
              Inquire Now
            </button>
          </div>
        </aside>
      </div>
    </div>
  </section>
</div>
