---
permalink: /bloomlight/
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% page_title = "Bloomlight Website Monitoring | Meadowbrook Bakery Demo" %>
<% description = "Explore how Bloomlight monitors website performance, accessibility, SEO, and uptime, and see a sample report for the Meadowbrook Bakery demo site." %>
<% canonical = resource.absolute_url %>
<% social_image = absolute_url "/images/bloomlight-social.jpg" %>
<% image_alt = "Bloomlight logo and wordmark over the Meadowbrook Bakery storefront" %>
<title><%= page_title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<link rel="icon" href="<%= relative_url "/images/favicon.svg" %>" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.metadata.title %>">
<meta property="og:title" content="<%= page_title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= social_image %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= image_alt %>">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image:alt" content="<%= image_alt %>">

<script type="application/ld+json">
<%== JSON.pretty_generate({
  "@context" => "https://schema.org",
  "@type" => "AboutPage",
  "@id" => canonical,
  "url" => canonical,
  "name" => page_title,
  "description" => description,
  "inLanguage" => "en",
  "mainEntity" => {
    "@type" => "WebApplication",
    "name" => "Bloomlight",
    "url" => "https://bloomlight.app/"
  }
}).gsub("<") { "\u003c" } %>
</script>
<style>
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #fff; }
main { width: min(90vw, 54rem); padding-block: 3rem; color: #061b0e; text-align: center; font: 1rem/1.6 system-ui, sans-serif; }
.lockup { display: block; width: min(100%, 42rem); overflow: visible; margin: 0 auto 2rem; }
p { max-width: 38rem; margin-inline: auto; }
nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem 1.5rem; margin-block: 1.5rem; }
a { color: #80552c; text-underline-offset: .2em; }
a:hover { color: #061b0e; }
@media (prefers-reduced-motion: reduce) {
  .lockup * { animation: none !important; transition: none !important; }
}

  /* the i dot shrinks away as the bloom grows from the same spot */
  #i-dot { transform-box: fill-box; transform-origin: center; transition: transform .25s ease-in .05s; }
  .word:hover #i-dot { transform: scale(0); transition-delay: 0s; }

  .bloom { transform-origin: 274.5px 259px; transform: scale(0); transition: transform .45s cubic-bezier(.3,1.4,.6,1); }
  .word:hover .bloom { transform: scale(1); }

  /* petals open about the flower's base; beams grow out from their tips */
  .bloom > g { transition: transform .5s cubic-bezier(.3,1.3,.6,1) var(--d), opacity .3s var(--d); opacity: 0; }
  .bloom .petal { transform-origin: 274.5px 507px; transform: rotate(var(--r)) scale(.3); }
  .bloom .beam { transform-box: fill-box; transform-origin: 50% 100%; transform: scale(0); }
  .word:hover .bloom > g { transform: none; opacity: 1; }
  .word:not(:hover) .bloom > g { transition-delay: 0s; }

  /* hovering the mark: the beams stretch upward and shimmer, like light through clouds */
  .mark .ray { transform-box: fill-box; transform-origin: 50% 100%; transition: transform .8s cubic-bezier(.2,.8,.3,1) var(--d); }
  .mark:hover .ray { transform: scale(1.06, 1.35); }
  .mark:hover .ray path { animation: shimmer 2.4s ease-in-out var(--d) infinite; }
  @keyframes shimmer {
    0%, 100% { opacity: 1; filter: brightness(1); }
    35% { opacity: var(--o); filter: brightness(var(--b)); }
    60% { opacity: calc((1 + var(--o)) / 2 + .2); filter: brightness(calc((1 + var(--b)) / 2)); }
  }

  /* butterflies: positioned by script, wings flap by CSS */
  #flutter { position: fixed; inset: 0; pointer-events: none; overflow: hidden; }
  .fly { position: absolute; left: 0; top: 0; width: 30px; height: 24px; margin: -12px 0 0 -15px; will-change: transform; }
  .fly svg { width: 100%; height: 100%; overflow: visible; }
  .fly .wl, .fly .wr { transform-box: fill-box; animation: flap var(--flap, .14s) ease-in-out infinite alternate; }
  .fly .wl { transform-origin: 100% 50%; }
  .fly .wr { transform-origin: 0 50%; }
  @keyframes flap { from { transform: scaleX(1); } to { transform: scaleX(.2); } }
</style>
</head>
<body>
<main>
