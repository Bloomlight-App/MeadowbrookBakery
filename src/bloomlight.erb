        <g class="petal" style="--r:-30deg;--d:.35s"><path d="M155 215c32 13 64 42 81 74 27 53 39 129 39 209-12-76-28-129-96-170-42-25-52-75-24-113" style="fill:#ffb3bd;fill-rule:nonzero" transform="matrix(-1 0 0 1 549 0)"/></g>
