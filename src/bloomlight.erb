    <rect y="-94" width="1280" height="420" fill="transparent"/>
    <g fill="none" stroke="rgb(130,21,51)" stroke-width="32">
        <circle cx="80" cy="162" r="64"/>
        <circle cx="304" cy="162" r="64"/>
        <circle cx="474" cy="162" r="64"/>
        <circle cx="961" cy="162" r="64"/>
        <path d="M14.791,-94L16,162M192,-34L192,204C192,216.069 201.931,226 214,226L219.5,226M581,242L581,139.5C581,116.734 599.734,98 622.5,98C645.266,98 664,116.734 664,139.5L664,242M664,139.5C664,116.734 682.734,98 705.5,98C728.266,98 747,116.734 747,139.5L747,242M796,-34L796,242M853,82L853,242M1025,162L1025,248C1025,282.012 997.012,310 963,310C928.988,310 901,282.012 901,248M1073.5,-34L1073.5,242M1073.5,151.25C1073.5,122.038 1097.538,98 1126.75,98C1155.962,98 1180,122.038 1180,151.25L1180,242M1227,20L1227,187C1227,208.395 1244.605,226 1266,226L1279.5,226M1227,98L1279.5,98"/>
      </g>
      <circle id="i-dot" cx="853" cy="40.5" r="23.5" fill="rgb(225,111,129)"/>
    <svg x="811.8" y="1.6" width="82.35" height="77.4" viewBox="0 0 549 516" overflow="visible">
      <g class="bloom">
        <g class="beam" style="--r:0deg;--d:.55s"><path d="M274.3 149.4c1.5-20.2 22.6-105.3 8.2-118-4.1-3.6-12.2-2.7-8.6-2.8-26 .5-4.1 113.2.4 120.8" style="fill:#ffb3bd;fill-rule:nonzero" transform="translate(0 9)"/></g>
        <g class="petal" style="--r:40deg;--d:.25s"><path d="M95 137c59 24 116 61 144 121 22 50 35 162 35 249-.988-.798-1.94-5.688-2.864-6.65-6.997-7.287-12.423-14.739-20.317-21.952C172.191 406.559 77.877 296.836 68 269c-17-43-1-97 27-132" style="fill:#e16f81;fill-rule:nonzero"/></g>
        <g class="petal" style="--r:-40deg;--d:.25s"><path d="M94 133c60 23 118 65 145 125 22 50 36 162 36 249-2.595-2.045-4.299-9.648-4.299-9.648s-6.754-8.755-10.398-11.952C179.173 414.218 82.989 296.834 70 269c-11-24-12-33-9-54 2.954-20.68 21-65 33-82" style="fill:#e16f81;fill-rule:nonzero" transform="matrix(-1 0 0 1 549 0)"/></g>
        <g class="beam" style="--r:0deg;--d:.6s"><path d="M244.5 131.8c-1.2-9.4-11.7-70.1-24.4-65.4-12.5 4.7 19.2 58.1 24.4 65.4m59.3.4c5-6.7 36.6-60.5 25.2-65-11.6-4.6-22.7 51.2-25.2 65" style="fill:#821533;fill-rule:nonzero" transform="translate(0 -22)"/></g>
