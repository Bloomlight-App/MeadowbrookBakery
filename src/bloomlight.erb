</svg>
<div id="flutter" aria-hidden="true"></div>
  <h1>Meet Bloomlight</h1>
  <p>Bloomlight monitors your website’s performance, accessibility, SEO, and uptime. It explains what needs attention in plain language and helps you fix common issues.</p>
  <nav aria-label="Bloomlight and demo links">
    <a href="https://bloomlight.app/">Visit Bloomlight</a>
    <a href="https://bloomlight.app/sample-report">View the demo report</a>
    <a href="<%= relative_url "/" %>">Back to Meadowbrook Bakery</a>
  </nav>
</main>
<script>
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const COUNT = 4;
  const COLOURS = [['#e16f81', '#ffb3bd'], ['#ffb3bd', '#e16f81'], ['#821533', '#e16f81'], ['#e16f81', '#821533']];
  const layer = document.getElementById('flutter');
  const lockup = document.querySelector('.lockup');
  const markBox = document.querySelector('.mark rect');
  const wordBox = document.querySelector('.word rect');

  // flower spots in each part's own coordinates: petal tips of the big flower, and the i bloom
  const BIG = [[275, 168], [153, 215], [396, 215], [95, 140], [454, 140]];
  const SMALL = [[853, 34]];

  const toScreen = (el, [x, y]) => new DOMPoint(x, y).matrixTransform(el.getScreenCTM());
  const rand = (a, b) => a + Math.random() * (b - a);
  const pick = a => a[Math.floor(Math.random() * a.length)];

  let hovered = null; // 'mark' | 'word' | null
  let flies = [];

  // a little jitter so two butterflies on the same spot don't stack exactly
  function flowerSpot() {
    const [el, spots, j] = hovered === 'word' && Math.random() < 0.6 ? [wordBox, SMALL, 6] : [markBox, BIG, 14];
    const [x, y] = pick(spots), spot = [x + rand(-j, j), y + rand(-j, j)];
    return () => toScreen(el, spot);
  }

  function edgePoint() {
    const w = innerWidth, h = innerHeight, m = 40;
    switch (Math.floor(Math.random() * 4)) {
      case 0: return { x: -m, y: rand(0, h) };
      case 1: return { x: w + m, y: rand(0, h) };
      case 2: return { x: rand(0, w), y: -m };
      default: return { x: rand(0, w), y: h + m };
    }
  }

  function wanderPoint() {
    const r = lockup.getBoundingClientRect(), pad = 60;
    return { x: rand(r.left - pad, r.right + pad), y: rand(r.top - pad, r.bottom + pad) };
  }

  function makeFly() {
    const [upper, lower] = pick(COLOURS);
    const el = document.createElement('div');
    el.className = 'fly';
    el.innerHTML = `<svg viewBox="-20 -16 40 32">
      <g class="wl"><path d="M0-1C-5-13-19-17-18-5-17 1-8 2 0 0Z" fill="${upper}"/><path d="M0 0C-8 2-15 8-11 13-7 16-2 8 0 2Z" fill="${lower}"/></g>
      <g class="wr"><path d="M0-1C5-13 19-17 18-5 17 1 8 2 0 0Z" fill="${upper}"/><path d="M0 0C8 2 15 8 11 13 7 16 2 8 0 2Z" fill="${lower}"/></g>
      <ellipse rx="1.6" ry="7" fill="#4a0b1d"/>
      <path d="M-.5-6Q-3-11-5-13M.5-6Q3-11 5-13" stroke="#4a0b1d" stroke-width=".8" fill="none"/>
    </svg>`;
    layer.appendChild(el);
    const p = edgePoint();
    return { el, x: p.x, y: p.y, vx: 0, vy: 0, angle: 0, phase: rand(0, 6.3), t: 0,
             state: 'arrive', goal: flowerSpot(), until: 0, delay: rand(0, 0.8) };
  }

  function setState(f, state) {
    f.state = state;
    f.t = 0;
    if (state === 'arrive') f.goal = flowerSpot();
    if (state === 'sniff') f.until = rand(1.2, 2.6);
    if (state === 'wander') { const p = wanderPoint(); f.goal = () => p; f.until = rand(2, 4); }
    if (state === 'leave') { const p = edgePoint(); f.goal = () => p; }
    f.el.style.setProperty('--flap', state === 'sniff' ? '.45s' : '.14s');
  }

  function step(f, dt) {
    if (f.delay > 0) { f.delay -= dt; return true; }
    f.t += dt;
    const g = f.goal();
    const dx = g.x - f.x, dy = g.y - f.y, dist = Math.hypot(dx, dy);
    const speed = { arrive: 150, wander: 70, sniff: 0, leave: 240 }[f.state];

    if (f.state === 'arrive' && dist < 4) setState(f, 'sniff');
    else if (f.state === 'sniff' && f.t > f.until) setState(f, Math.random() < 0.3 ? 'arrive' : 'wander');
    else if (f.state === 'wander' && (dist < 10 || f.t > f.until)) setState(f, Math.random() < 0.35 ? 'arrive' : 'wander');
    else if (f.state === 'leave' && dist < 10) { f.el.remove(); return false; }

    // steer toward the goal, easing in as it gets close
    const want = f.state === 'sniff' ? 0 : speed * Math.min(1, dist / 80);
    const tx = dist ? dx / dist * want : 0, ty = dist ? dy / dist * want : 0;
    const k = f.state === 'sniff' ? 6 : 2.5;
    f.vx += (tx - f.vx) * k * dt;
    f.vy += (ty - f.vy) * k * dt;
    if (f.state === 'sniff') { f.x += (g.x - f.x) * 4 * dt; f.y += (g.y - f.y) * 4 * dt; }
    f.x += f.vx * dt;
    f.y += f.vy * dt;

    // lazy wobble on top of the path, and turn to face the direction of travel
    const wob = f.state === 'sniff' ? 1 : 6;
    const ox = Math.sin(f.t * 3.1 + f.phase) * wob, oy = Math.sin(f.t * 4.7 + f.phase * 2) * wob;
    const v = Math.hypot(f.vx, f.vy);
    const target = v > 15 ? Math.atan2(f.vy, f.vx) * 180 / Math.PI + 90 : Math.sin(f.t * 1.3 + f.phase) * 15;
    f.angle += (((target - f.angle + 540) % 360) - 180) * Math.min(1, 5 * dt);
    f.el.style.transform = `translate(${f.x + ox}px, ${f.y + oy}px) rotate(${f.angle}deg)`;
    return true;
  }

  let last = 0, running = false;
  function frame(now) {
    const dt = Math.min(0.05, (now - last) / 1000 || 0);
    last = now;
    flies = flies.filter(f => step(f, dt));
    if (flies.length) requestAnimationFrame(frame); else running = false;
  }

  let leaveTimer;
  function enter(part) {
    clearTimeout(leaveTimer);
    hovered = part;
    flies.forEach(f => { if (f.state === 'leave') setState(f, 'arrive'); });
    while (flies.length < COUNT) flies.push(makeFly());
    if (!running) { running = true; last = performance.now(); requestAnimationFrame(frame); }
  }
  function leave() {
    leaveTimer = setTimeout(() => { hovered = null; flies.forEach(f => setState(f, 'leave')); }, 300);
  }

  for (const [sel, part] of [['.mark', 'mark'], ['.word', 'word']]) {
    const el = document.querySelector(sel);
    el.addEventListener('mouseenter', () => enter(part));
    el.addEventListener('mouseleave', leave);
    el.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'touch') {
        enter(part);
        setTimeout(leave, 2200);
      }
    });
  }
})();
</script>
</body>
</html>
