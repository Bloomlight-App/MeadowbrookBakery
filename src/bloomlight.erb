        <g class="petal" style="--r:-60deg;--d:.1s"><path d="M3 274c82-14 157 37 198 107 25 44 61 76 74 126-50-66-139-53-199-101-40-31-63-84-73-132" style="fill:#821533;fill-rule:nonzero" transform="matrix(-1 0 0 1 549 0)"/></g>
        <g class="petal" style="--r:0deg;--d:.3s"><path d="M275 177.782C256 215 181 260.29 218 358.399c16 37 54 105.491 57 145.546 6-17 11-43.945 22-61.945 89-142 11-202-22-264.218" style="fill:#821533;fill-rule:nonzero" transform="matrix(1 0 0 1.05775 -1 -26.049)"/></g>
