<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<% resource_title = strip_html(strip_newlines(title)) %>
<%# The home page leads with the tagline; every other page is "Page | Site".
    Held in a variable so <title> and og:title can never drift apart. %>
<% page_title = resource_title == "Index" ? "#{metadata.title}: #{metadata.tagline}" : "#{resource_title} | #{metadata.title}" %>
<title><%= page_title %></title>

<meta name="description" content="<%= metadata.description %>" />

<%# High in the head, the way every one of these snippets asks to be — but not on
    the error pages, which opt out of discovery below for the same reason: nobody
    goes there on purpose, so there is nothing worth counting. %>
<% unless resource.data.noindex %>
<%= render "trackers" %>
<% end %>

<%# The error pages are reached by accident, never linked or shared, and their
    permalinks keep a .html suffix that absolute_url strips — so a canonical
    here would point at a URL that does not exist. Skip the discovery tags. %>
<% if resource.data.noindex %>
<meta name="robots" content="noindex" />
<% else %>
<link rel="canonical" href="<%= resource.absolute_url %>" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= metadata.title %>" />
<meta property="og:title" content="<%= page_title %>" />
<meta property="og:description" content="<%= metadata.description %>" />
<meta property="og:url" content="<%= resource.absolute_url %>" />
<%# Absolute by necessity: scrapers do not resolve relative og:image paths. %>
<meta property="og:image" content="<%= absolute_url "/images/photos/hero-meadow.jpg" %>" />
<% end %>

<link rel="icon" href="<%= relative_url "/images/favicon.svg" %>" type="image/svg+xml" />
<link rel="icon" href="<%= relative_url "/favicon.ico" %>" sizes="32x32" />
<link rel="apple-touch-icon" href="<%= relative_url "/images/apple-touch-icon.png" %>" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,200..800&family=Work+Sans:wght@300;400;500;600&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<%# Carried over verbatim from the design source: the `main > :first-child`
    reset is what lets the full-bleed heroes pull up under the fixed header. %>
<style>
  @layer base {
    html, body { margin: 0; padding: 0; }
    body { overscroll-behavior: none; }
    main > :first-child { margin-top: 0 !important; }
    main > :last-child { margin-bottom: 0 !important; }
  }
  ::-webkit-scrollbar { display: none; }
</style>

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
